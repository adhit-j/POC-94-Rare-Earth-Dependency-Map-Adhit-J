# World Bank API
# We use the public World Bank Open Data API for macroeconomic exports.
# Key is optional but can be used for higher rate limits.
WORLD_BANK_API_KEY=YOUR_WORLD_BANK_API_KEY_HERE

# USGS MRDS (Mineral Resources Data System) API
# Used to fetch real-time extraction node metadata.
USGS_API_KEY=YOUR_USGS_API_KEY_HERE

# Server Config
PORT=8000
ENVIRONMENT=development
